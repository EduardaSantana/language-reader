# Copy to .env.local (gitignored) and fill in real values. Never commit .env.local.

# Phase 1 — image fetch for saved words / dictionary (Collection tab).
# Get a free key at unsplash.com/developers. VITE_-prefixed vars are inlined
# into the client bundle by Vite, so this key IS visible in shipped JS —
# acceptable for Unsplash's free/demo tier (rate-limited per app, read-only
# search), but if usage grows, move this behind a small serverless proxy
# the way Phase 2 already does for the Gemini key.
VITE_UNSPLASH_ACCESS_KEY=

# Phase 2 — not needed yet. Server-side only (Vercel serverless function),
# deliberately NOT VITE_-prefixed so it never reaches client code.
GEMINI_API_KEY=

# Phase 2 — Neon Postgres connection string, provisioned via the Vercel
# dashboard's Storage tab (Neon integration, free tier). Server-side only.
DATABASE_URL=
